<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="shelly"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="shellypluscamera">
		<label>Shelly Camera</label>
		<description>Shelly Camera - Indoor Wi-Fi camera with motion detection, night vision and two-way audio</description>
		<category>Camera</category>
		<semantic-equipment-tag>Camera</semantic-equipment-tag>
		<channel-groups>
			<channel-group id="control" typeId="control"/>
			<channel-group id="sensors" typeId="cameraSensors"/>
			<channel-group id="media" typeId="cameraMedia"/>
			<channel-group id="camera" typeId="camera"/>
			<channel-group id="zones" typeId="cameraZones"/>
			<channel-group id="device" typeId="deviceStatus"/>
		</channel-groups>

		<representation-property>serviceName</representation-property>
		<config-description-ref uri="thing-type:shelly:relay-gen2"/>
	</thing-type>

	<channel-group-type id="cameraSensors">
		<label>Sensors</label>
		<description>Motion detection and camera events</description>
		<channels>
			<channel id="event" typeId="cameraEvent"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="cameraMedia">
		<label>Audio</label>
		<description>Speaker and microphone settings</description>
	</channel-group-type>

	<channel-group-type id="camera">
		<label>Camera</label>
		<description>Video streaming, night vision and motion detection settings</description>
	</channel-group-type>

	<channel-group-type id="cameraZones">
		<label>Motion Zones</label>
		<description>Motion state of each motion zone configured on the device</description>
	</channel-group-type>

	<channel-type id="cameraEvent">
		<kind>trigger</kind>
		<label>Camera Event</label>
		<description>Triggered on motion start/end, arm/disarm and privacy mode changes</description>
		<event>
			<options>
				<option value="MOTION">Motion detected</option>
				<option value="MOTION_END">Motion ended</option>
				<option value="ARMED">Armed</option>
				<option value="DISARMED">Disarmed</option>
				<option value="PRIVACY_ON">Privacy mode on</option>
				<option value="PRIVACY_OFF">Privacy mode off</option>
			</options>
		</event>
	</channel-type>

	<channel-type id="cameraArmed">
		<item-type>Switch</item-type>
		<label>Armed</label>
		<description>ON: motion events and recordings are active</description>
		<tags>
			<tag>Switch</tag>
			<tag>Enabled</tag>
		</tags>
	</channel-type>

	<channel-type id="cameraPrivacy">
		<item-type>Switch</item-type>
		<label>Privacy Mode</label>
		<description>ON: video and audio capture are disabled</description>
		<tags>
			<tag>Switch</tag>
			<tag>Enabled</tag>
		</tags>
	</channel-type>

	<channel-type id="cameraStreamerState" advanced="true">
		<item-type>String</item-type>
		<label>Streamer State</label>
		<description>State of the camera's video streamer</description>
		<tags>
			<tag>Status</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="stopped">Stopped</option>
				<option value="starting">Starting</option>
				<option value="running">Running</option>
				<option value="stopping">Stopping</option>
				<option value="unknown">Unknown</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="cameraNightVisionMode">
		<item-type>String</item-type>
		<label>Night Vision Mode</label>
		<description>Night vision mode: switch automatically by ambient light, or force day/night mode</description>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state>
			<options>
				<option value="auto">Auto</option>
				<option value="day">Day</option>
				<option value="night">Night</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="cameraIrLeds" advanced="true">
		<item-type>Switch</item-type>
		<label>IR LEDs</label>
		<description>ON: infrared LEDs are used in night mode</description>
		<tags>
			<tag>Switch</tag>
			<tag>Enabled</tag>
		</tags>
	</channel-type>

	<channel-type id="cameraMotionSensitivity">
		<item-type>String</item-type>
		<label>Motion Sensitivity</label>
		<description>Sensitivity of the motion detection</description>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state>
			<options>
				<option value="low">Low</option>
				<option value="medium">Medium</option>
				<option value="high">High</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="cameraRecordOnMotion">
		<item-type>Switch</item-type>
		<label>Record on Motion</label>
		<description>ON: a recording is started when motion is detected</description>
		<tags>
			<tag>Switch</tag>
			<tag>Enabled</tag>
		</tags>
	</channel-type>

	<channel-type id="mediaSounds" advanced="true">
		<item-type>Switch</item-type>
		<label>Device Sounds</label>
		<description>ON: the device plays built-in notification sounds</description>
		<tags>
			<tag>Switch</tag>
			<tag>Enabled</tag>
		</tags>
	</channel-type>

	<channel-type id="mediaPlaySound">
		<item-type>String</item-type>
		<label>Play Sound</label>
		<description>Play one of the built-in sounds on the device speaker</description>
		<tags>
			<tag>Control</tag>
		</tags>
		<command>
			<options>
				<option value="alert">Alert</option>
				<option value="ding-dong">Ding-Dong</option>
				<option value="notification">Notification</option>
			</options>
		</command>
	</channel-type>

	<channel-type id="cameraRtspEnabled" advanced="true">
		<item-type>Switch</item-type>
		<label>RTSP Streaming</label>
		<description>ON: the RTSP video streams are enabled, see Thing properties for the stream URLs</description>
		<tags>
			<tag>Switch</tag>
			<tag>Enabled</tag>
		</tags>
	</channel-type>

	<channel-type id="cameraSnapshot">
		<item-type>Image</item-type>
		<label>Snapshot</label>
		<description>Latest camera image, updated on motion and on a REFRESH command (not available in privacy mode)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="cameraTakeSnapshot">
		<item-type>Switch</item-type>
		<label>Take Snapshot</label>
		<description>ON: fetch a new camera image into Snapshot, switches back to OFF automatically</description>
		<tags>
			<tag>Switch</tag>
		</tags>
	</channel-type>

	<channel-type id="cameraLastEvent">
		<item-type>String</item-type>
		<label>Last Event Type</label>
		<description>Type of the last camera event</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="MOTION">Motion detected</option>
				<option value="ARMED">Armed</option>
				<option value="DISARMED">Disarmed</option>
				<option value="PRIVACY_ON">Privacy mode on</option>
				<option value="PRIVACY_OFF">Privacy mode off</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="cameraLastEventTimestamp">
		<item-type>DateTime</item-type>
		<label>Last Event Time</label>
		<description>Time of the last camera event</description>
		<category>Time</category>
		<tags>
			<tag>Status</tag>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="cameraLastEventZone">
		<item-type>String</item-type>
		<label>Last Event Zone</label>
		<description>Name of the motion zone that reported the last motion</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="cameraLastEventImage">
		<item-type>Image</item-type>
		<label>Last Event Image</label>
		<description>Camera image taken when the last motion was detected</description>
		<state readOnly="true"/>
	</channel-type>
</thing:thing-descriptions>
